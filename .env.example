# Supabase (required for auth and session storage).
# Copy this file to .env.local and fill in your project values.
# Do not commit .env.local.
# Production app uses project ref qhhmcsdteqcuhvdqhkfo. Run:
#   supabase link --project-ref qhhmcsdteqcuhvdqhkfo
# before `supabase db query` / `db push`, or migrations hit the wrong database.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: canonical/social base URL (e.g. for production subdomain).
# When set, canonicals and og:image URLs use this instead of window.location.origin.
# It also overrides the origin used for Supabase password-reset links, which otherwise
# always point at https://ucat.theukcatpeople.co.uk - the only origin on the Supabase
# auth redirect allow-list. Only set this to a local or preview origin after adding that
# origin under Supabase > Authentication > URL Configuration > Redirect URLs; otherwise
# Supabase silently rewrites the link to the site home page.
# Example: https://ucat.theukcatpeople.co.uk
VITE_SITE_URL=

# Deployed Next.js planner (study plan + mock scores). Same Supabase project as above.
# Example: https://plan.theukcatpeople.co.uk
VITE_PLANNER_URL=

# Mailchimp (Edge Function secrets - set via Supabase Dashboard or CLI, not here):
# MAILCHIMP_API_KEY=your-mailchimp-api-key
# MAILCHIMP_LIST_ID=your-audience-list-id

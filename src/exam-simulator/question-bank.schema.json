{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/ucat-question-bank.schema.json",
  "title": "Local UCAT simulator question bank",
  "type": "object",
  "required": ["title", "sections"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "required": ["id", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "table": {
      "type": "object",
      "required": ["headers", "rows"],
      "additionalProperties": false,
      "properties": {
        "headers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "editorial": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["draft", "in-review", "approved", "changes-requested"]
        },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "default": [],
          "items": { "type": "string", "minLength": 1 }
        },
        "author": { "type": "string" },
        "reviewer": { "type": "string" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "question": {
      "type": "object",
      "required": ["id", "type", "prompt"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["choice", "yes-no", "most-least"] },
        "passage": { "type": "string" },
        "prompt": { "type": "string", "minLength": 1 },
        "layout": { "enum": ["split", "full"], "default": "full" },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/option" }
        },
        "statements": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1 }
        },
        "table": { "$ref": "#/$defs/table" },
        "image": {
          "type": "string",
          "pattern": "^data:image/(png|jpeg|webp);base64,"
        },
        "correctAnswer": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "explanation": { "type": "string" },
        "editorial": { "$ref": "#/$defs/editorial" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "yes-no" } } },
          "then": { "required": ["statements"] },
          "else": { "required": ["options"] }
        },
        {
          "if": {
            "properties": {
              "editorial": {
                "properties": { "status": { "const": "approved" } },
                "required": ["status"]
              }
            },
            "required": ["editorial"]
          },
          "then": { "required": ["correctAnswer", "explanation"] }
        }
      ]
    },
    "section": {
      "type": "object",
      "required": ["id", "name", "durationSeconds", "questions"],
      "additionalProperties": false,
      "properties": {
        "id": { "enum": ["VR", "DM", "QR", "SJT"] },
        "name": { "type": "string", "minLength": 1 },
        "durationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14400
        },
        "instructionSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600,
          "default": 90
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/question" }
        }
      }
    }
  }
}
